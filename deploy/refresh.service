[Unit]
Description=Daily ATP + OSM data refresh for ${PROJECT_NAME}
After=network.target
# A source being down (Geofabrik 502, ATP, NSI) exits non-zero: retry every
# 4h, 3 times, so the last attempt is 12h after the first run. The sources that
# did answer are already imported by then, so the retries run much shorter.
StartLimitIntervalSec=1d
StartLimitBurst=4

[Service]
Type=oneshot
ExecStart=${PROJECT_DIR}/run-pipeline.sh
EnvironmentFile=${PROJECT_DIR}/.env
WorkingDirectory=${PROJECT_DIR}
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=4h
MemoryMax=2G
MemorySwapMax=512M
