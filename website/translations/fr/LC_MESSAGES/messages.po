#, python-format
msgid "A changeset went wrong? It can be reverted with <a class=\"link\" href=\"%(link)s\" target=\"_blank\" rel=\"noopener\">OSM Revert</a>, by pasting in the identifier of the changeset concerned."
msgstr "Un changeset s'est mal passé ? Il peut être annulé avec <a class=\"link\" href=\"%(link)s\" target=\"_blank\" rel=\"noopener\">OSM Revert</a>, en y collant l'identifiant du changeset concerné."

#: website/templates/history_detail.html:221
msgid "No changeset recorded."
msgstr "Aucun changeset enregistré."

